# Public-host template: replace domains and configure the host before use.
# Regulatory information, not legal advice.
# Requires services on the SAME host/network namespace at loopback ports below.
# Separate origins keep the scanner's root-scoped service worker isolated.
# No authentication or rate limiter is configured here. This is not the local
# TLS test config; validate_local_tls.sh creates its own temporary configuration.
{
	admin off
}
api.EXAMPLE {
	encode zstd gzip
	request_body {
		max_size 1MiB
	}
	reverse_proxy 127.0.0.1:8000
}
scan.EXAMPLE {
	encode zstd gzip
	request_body {
		max_size 1MiB
	}
	reverse_proxy 127.0.0.1:8010
}
# Body limits apply to uploads, not downloaded OCR assets. OCR runs in-browser;
# photos are not uploaded to these API endpoints.
